  const ex = params.getString('ex')
  if (recvMsgOpt != null) { payload = appendPayloadField(payload, '"recvMsgOpt":' + stringifyJSON(recvMsgOpt)) }
  if (isPinned != null) { payload = appendPayloadField(payload, '"isPinned":' + stringifyJSON(isPinned)) }
  if (isPrivateChat != null) { payload = appendPayloadField(payload, '"isPrivateChat":' + stringifyJSON(isPrivateChat)) }
  if (burnDuration != null) { payload = appendPayloadField(payload, '"burnDuration":' + stringifyJSON(burnDuration)) }
  if (groupAtType != null) { payload = appendPayloadField(payload, '"groupAtType":' + stringifyJSON(groupAtType)) }
  if (ex != null) { payload = appendPayloadField(payload, '"ex":' + stringifyJSON(ex)) }
  return '{' + payload + '}'
}
