function optionalString(value ?: string | null) : string { return value != null ? value as string : '' }
function optionalBoolean(value ?: boolean | null) : boolean { return value != null ? value as boolean : false }
function optionalNumber(value ?: number | null) : number { return value != null ? value as number : 0 }

function normalizeIOSLocalMediaPath(path : string) : string {
  if (path.indexOf('unifile://') == 0 || path.indexOf('unifile:') == 0) {
    return UTSiOS.convert2AbsFullPath(path)
  }
  if (path.indexOf('file://') == 0) {
    return path.substring(7)
  }
  return path
}

function normalizeIOSUploadFileParams(params : OpenIMUploadFileParams) : OpenIMUploadFileParams {
  const normalized : OpenIMUploadFileParams = { filepath: normalizeIOSLocalMediaPath(params.filepath), name: params.name, contentType: params.contentType, uuid: params.uuid }
  if (params.cancelID != null) { normalized.cancelID = params.cancelID }
  if (params.cause != null) { normalized.cause = params.cause }
  return normalized
}

function readOfflinePushInfo(options : OpenIMSendMessageOptions) : string { return options.offlinePushInfo != null ? stringifyJSON(options.offlinePushInfo) : '{}' }
function readIsOnlineOnly(options : OpenIMSendMessageOptions) : boolean { return options.isOnlineOnly != null ? options.isOnlineOnly as boolean : false }
function readOperationID(options : OpenIMSendMessageOptions) : string { return normalizeOperationID(options.operationID) }
function appendPayloadField(payload : string, field : string) : string { return payload.length > 0 ? payload + ',' + field : field }
function stringifyUpdateFriendsPayload(params : UTSJSONObject) : string { // UTS-COMPAT-ALLOW:UTS-BOUNDARY-JSONOBJECT
  let payload = ''
  const friendUserIDs = params.getArray<string>('friendUserIDs')
  const isPinned = params.getBoolean('isPinned')
  const remark = params.getString('remark')
  const ex = params.getString('ex')
  payload = appendPayloadField(payload, '"friendUserIDs":' + stringifyJSON(friendUserIDs))
  if (isPinned != null) { payload = appendPayloadField(payload, '"isPinned":' + stringifyJSON(isPinned)) }
  if (remark != null) { payload = appendPayloadField(payload, '"remark":' + stringifyJSON(remark)) }
  if (ex != null) { payload = appendPayloadField(payload, '"ex":' + stringifyJSON(ex)) }
  return '{' + payload + '}'
}
